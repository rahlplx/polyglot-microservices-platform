{
  "consumer": "catalog",
  "provider": "auth",
  "pactSpecification": { "version": "2.0.0" },
  "interactions": [
    {
      "description": "A request to check if a user has catalog:read permission",
      "providerState": "user customer-001 has catalog:read permission",
      "request": {
        "method": "POST",
        "path": "/v1/auth.CheckPermission",
        "headers": { "Content-Type": "application/grpc" },
        "body": {
          "user_id": "customer-001",
          "permission": "catalog:read"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "allowed": true
        }
      }
    },
    {
      "description": "A request to check if a suspended user has permission",
      "providerState": "user suspended-001 is suspended",
      "request": {
        "method": "POST",
        "path": "/v1/auth.CheckPermission",
        "headers": { "Content-Type": "application/grpc" },
        "body": {
          "user_id": "suspended-001",
          "permission": "catalog:read"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "allowed": false,
          "denial_reason": "account_suspended"
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": { "version": "2.0.0" }
  }
}
