# Identity Service - Environment Variables
# Copy this file to .env and customize for your environment

# Server
IDENTITY_GRPC_BIND_ADDR=0.0.0.0:9090
IDENTITY_HTTP_BIND_ADDR=0.0.0.0:8080

# Database
IDENTITY_DATABASE_URL=postgres://identity:identity@localhost:5432/identity
IDENTITY_DATABASE_MAX_CONNECTIONS=10
IDENTITY_DATABASE_MIN_CONNECTIONS=2

# SPIRE Agent
IDENTITY_SPIRE_AGENT_SOCKET=/run/spire/sockets/agent.sock
IDENTITY_TRUST_DOMAIN=trust.example.org

# Certificate Policy
IDENTITY_MAX_TTL_SECONDS=259200
IDENTITY_DEFAULT_PRODUCTION_TTL=3600
IDENTITY_DEFAULT_STAGING_TTL=14400
IDENTITY_DEFAULT_DEVELOPMENT_TTL=86400
IDENTITY_GRACE_PERIOD_SECONDS=300
IDENTITY_ATTESTATION_TTL_SECONDS=300

# Observability
IDENTITY_OTLP_ENDPOINT=http://localhost:4317
IDENTITY_LOG_LEVEL=info
IDENTITY_VERIFICATION_SAMPLE_RATE=0.1

# Feature Flags
IDENTITY_FEATURE_SPIRE_CLIENT=true
IDENTITY_FEATURE_POSTGRES_STORE=true
IDENTITY_FEATURE_MTLS=false
IDENTITY_FEATURE_AUDIT_LOG=true
