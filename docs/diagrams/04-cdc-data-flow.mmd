%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E9EEF3', 'primaryTextColor': '#243447', 'primaryBorderColor': '#4C6EF5', 'lineColor': '#64748B', 'secondaryColor': '#EFF6FF', 'tertiaryColor': '#F8FAFC', 'fontSize': '13px'}}}%%
graph LR
    subgraph Source["Source Database"]
        PG["🐘 PostgreSQL<br/>WAL-Enabled"]
        OUTBOX["📤 Outbox Table<br/><i>order_outbox_events</i>"]
    end

    subgraph Capture["Change Capture — SC-5: CDC Pipeline"]
        DEBEZIUM["🔄 Debezium Connect<br/>Connector<br/><i>Captures WAL Changes</i>"]
    end

    subgraph Transport["Event Transport"]
        KAFKA_ORD["📨 Kafka Topic<br/><i>order.changes</i>"]
        KAFKA_CAT["📨 Kafka Topic<br/><i>catalog.changes</i>"]
        KAFKA_PAY["📨 Kafka Topic<br/><i>payment.changes</i>"]
    end

    subgraph Validation["Schema Validation"]
        SCHEMA["📐 Schema Registry<br/><b>Go</b><br/>Avro / Protobuf<br/>Schema Validation"]
        CHECKSUM["✅ Checksum Validation<br/><i>Migration Integrity</i>"]
    end

    subgraph Consumers["Event Consumers"]
        ORD_SVC["📋 Order Service<br/><b>Java/Kotlin</b><br/>gRPC + Outbox"]
        NOTIF_SVC["🔔 Notification Service<br/><b>Python</b><br/>CloudEvents"]
        ANAL_SVC["📊 Analytics Service<br/><b>Python</b><br/>CloudEvents + gRPC"]
    end

    %% Outbox pattern flow
    subgraph OutboxPattern["Outbox Pattern Flow"]
        DOMAIN["🏛️ Domain Logic<br/>Writes Business Data"]
        OUTBOX_WRITE["→ Outbox Write<br/>Atomic with Business Data"]
        DEBEZIUM_READ["→ Debezium Reads<br/>Outbox Table CDC"]
        KAFKA_EMIT["→ Kafka Emit<br/>Change Event"]
        CONSUME["→ Consumers<br/>Process Events"]
    end

    %% Main flow
    PG -->|"WAL Stream"| DEBEZIUM
    OUTBOX -->|"CDC Capture"| DEBEZIUM
    DEBEZIUM -->|"order events"| KAFKA_ORD
    DEBEZIUM -->|"catalog events"| KAFKA_CAT
    DEBEZIUM -->|"payment events"| KAFKA_PAY

    KAFKA_ORD -->|"validate"| SCHEMA
    KAFKA_CAT -->|"validate"| SCHEMA
    KAFKA_PAY -->|"validate"| SCHEMA
    SCHEMA -->|"checksum"| CHECKSUM

    CHECKSUM -->|"verified"| ORD_SVC
    CHECKSUM -->|"verified"| NOTIF_SVC
    CHECKSUM -->|"verified"| ANAL_SVC

    %% Outbox pattern sequence
    DOMAIN --> OUTBOX_WRITE
    OUTBOX_WRITE --> OUTBOX
    OUTBOX --> DEBEZIUM_READ
    DEBEZIUM_READ --> KAFKA_EMIT
    KAFKA_EMIT --> CONSUME

