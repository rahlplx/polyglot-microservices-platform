%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E9EEF3', 'primaryTextColor': '#243447', 'primaryBorderColor': '#4C6EF5', 'lineColor': '#64748B', 'secondaryColor': '#EFF6FF', 'tertiaryColor': '#F8FAFC', 'fontSize': '13px'}}}%%
graph TB
    subgraph OutboundAdapters["Outbound Adapters"]
        DB_A["🗄️ DB Adapter<br/>PostgreSQL / MongoDB"]
        KAFKA_A["📤 Kafka Adapter<br/>CloudEvents Producer"]
        OTEL_A["🔭 OTel Adapter<br/>Traces + Metrics Export"]
        ACL_A["🛡️ ACL Sidecar<br/>Proprietary Isolation"]
    end

    subgraph OutboundPorts["Outbound Ports — Infrastructure Interfaces"]
        DB_P["«interface»<br/>RepositoryPort"]
        KAFKA_P["«interface»<br/>EventPublisherPort"]
        OTEL_P["«interface»<br/>ObservabilityPort"]
        ACL_P["«interface»<br/>ExternalServicePort"]
    end

    subgraph Domain["Domain Core — SC-3: Business Logic"]
        ENT["📌 Entities<br/>& Value Objects"]
        UC["⚙️ Use Cases<br/>& Domain Services"]
        DOMAIN_EVENT["📡 Domain Events"]
    end

    subgraph InboundPorts["Inbound Ports — Use Case Interfaces"]
        GRPC_P["«interface»<br/>GrpcUseCase"]
        REST_P["«interface»<br/>RestUseCase"]
        EVENT_P["«interface»<br/>EventHandler"]
    end

    subgraph InboundAdapters["Inbound Adapters"]
        GRPC_A["🔌 gRPC Handler<br/>Protobuf Definitions"]
        REST_A["🌐 REST Controller<br/>OpenAPI Endpoints"]
        EVENT_A["📨 Event Consumer<br/>CloudEvents Subscriber"]
    end

    %% Dependency Rule: Adapters → Ports → Domain → Nothing
    GRPC_A -->|"implements"| GRPC_P
    REST_A -->|"implements"| REST_P
    EVENT_A -->|"implements"| EVENT_P

    GRPC_P -->|"orchestrates"| UC
    REST_P -->|"orchestrates"| UC
    EVENT_P -->|"orchestrates"| UC

    UC -->|"uses"| ENT
    UC -->|"emits"| DOMAIN_EVENT

    UC -->|"depends on"| DB_P
    UC -->|"depends on"| KAFKA_P
    UC -->|"depends on"| OTEL_P
    UC -->|"depends on"| ACL_P

    DB_P -->|"implemented by"| DB_A
    KAFKA_P -->|"implemented by"| KAFKA_A
    OTEL_P -->|"implemented by"| OTEL_A
    ACL_P -->|"implemented by"| ACL_A

    %% Dependency rule annotation
    DEP_RULE["📋 Dependency Rule<br/>Adapters → Ports → Domain<br/>Domain depends on NOTHING<br/>SC-3: Hexagonal Enforcement"]

