%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#E9EEF3', 'primaryTextColor': '#243447', 'primaryBorderColor': '#4C6EF5', 'lineColor': '#64748B', 'secondaryColor': '#EFF6FF', 'tertiaryColor': '#F8FAFC', 'fontSize': '12px'}}}%%
graph TB
    subgraph NS["Namespace: production"]
        subgraph ArgoCD["GitOps Control Plane"]
            ARGO["🎯 ArgoCD<br/>Application Controller<br/>1 replica"]
        end

        subgraph Services["Application Services"]
            GW_POD["🚪 Gateway Pod<br/><b>Go</b> | 2 replicas<br/>CPU: 250m / Mem: 256Mi"]
            ID_POD["🔐 Identity Pod<br/><b>Rust</b> | 3 replicas<br/>CPU: 200m / Mem: 128Mi"]
            CAT_POD["📦 Catalog Pod<br/><b>Node.js</b> | 2 replicas<br/>CPU: 250m / Mem: 256Mi"]
            ORD_POD["📋 Order Pod<br/><b>Java/Kotlin</b> | 3 replicas<br/>CPU: 500m / Mem: 512Mi"]
            PAY_POD["💰 Payment Pod<br/><b>Go</b> | 2 replicas<br/>CPU: 250m / Mem: 256Mi"]
            NOTIF_POD["🔔 Notification Pod<br/><b>Python</b> | 2 replicas<br/>CPU: 250m / Mem: 256Mi"]
            ANAL_POD["📊 Analytics Pod<br/><b>Python</b> | 2 replicas<br/>CPU: 500m / Mem: 512Mi"]
        end

        subgraph DataPlane["Data Plane — SC-5: CDC Pipeline"]
            KAFKA["📨 Kafka Cluster<br/>3 brokers | HA"]
            DEBEZIUM["🔄 Debezium Connect<br/>2 replicas"]
            CDC_POD["🔄 CDC Relay Pod<br/><b>Java</b> | 2 replicas"]
        end

        subgraph Identity["Zero-Trust Identity — SC-5: mTLS"]
            SPIRE_SVR["🔐 SPIRE Server<br/>3 replicas | HA"]
            SPIRE_AGNT["🔐 SPIRE Agent<br/>DaemonSet | 1/node"]
        end

        subgraph Observability["Observability Stack — SC-4: OTel"]
            OTEL_DS["🔭 OTel Collector<br/>DaemonSet | 1/node"]
            OTEL_GW["🔭 OTel Gateway<br/>2 replicas | HA"]
            PROM["📈 Prometheus<br/>2 replicas"]
            TEMPO["🔍 Grafana Tempo<br/>Distributed Traces"]
            LOKI["📝 Grafana Loki<br/>Log Aggregation"]
            GRAFANA["📊 Grafana<br/>Dashboards"]
        end

        subgraph Registry["Schema Registry"]
            SCHEMA_POD["📐 Schema Registry Pod<br/><b>Go</b> | 2 replicas"]
        end
    end

    %% Data flow arrows
    ARGO -->|"Git Sync"| Services
    OTEL_DS -->|"Traces/Metrics"| OTEL_GW
    OTEL_GW -->|"Push"| TEMPO
    OTEL_GW -->|"Push"| LOKI
    PROM -->|"Scrape"| OTEL_GW
    GRAFANA -->|"Query"| PROM
    GRAFANA -->|"Query"| TEMPO
    GRAFANA -->|"Query"| LOKI

    Services -->|"Emit Telemetry"| OTEL_DS
    Services -->|"Produce Events"| KAFKA
    KAFKA -->|"Consume"| DEBEZIUM
    DEBEZIUM -->|"WAL CDC"| CDC_POD

    SPIRE_SVR -->|"SVID Issuance"| SPIRE_AGNT
    SPIRE_AGNT -->|"Workload API"| Services

    CDC_POD -->|"Schema Validate"| SCHEMA_POD

