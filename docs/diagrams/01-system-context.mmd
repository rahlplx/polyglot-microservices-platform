        NOTIF["🔔 Notification Service<br/><b>Python</b><br/>CloudEvents Consumer"]
        ANAL["📊 Analytics Service<br/><b>Python</b><br/>CloudEvents + gRPC Query"]
    end

    subgraph Infra["Infrastructure Services"]
        CDC["🔄 CDC Relay<br/><b>Java</b><br/>Kafka Producer"]
        SCHEMA["📐 Schema Registry<br/><b>Go</b><br/>gRPC + REST"]
    end

    Users -->|"HTTPS"| GW
    Cloud -->|"Events / APIs"| GW
    GW -->|"mTLS"| ID
