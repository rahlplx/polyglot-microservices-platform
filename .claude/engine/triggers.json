{
  "version": "2.0.0",
  "engine": "auto-trigger-v2",
  "description": "Precise auto-trigger system with failover chains for AI-only workflow enforcement",

  "triggers": {
    "session_start": {
      "order": 1,
      "auto": true,
      "blocking": true,
      "description": "Fires at every session start. Loads config, verifies gstack, checks freeze state.",
      "actions": [
        {"action": "read_claude_md", "file": "/home/z/my-project/CLAUDE.md", "required": true},
        {"action": "read_agents_md", "file": "/home/z/my-project/AGENTS.md", "required": true},
        {"action": "read_worklog", "file": "/home/z/my-project/worklog.md", "required": false},
        {"action": "verify_gstack", "check": "ls ~/.claude/skills/gstack/setup", "required": true},
        {"action": "check_freeze", "file": "/home/z/my-project/.freeze", "required": false, "inverted": true},
        {"action": "inject_context", "template": "session_context", "required": true}
      ],
      "failover": {
        "gstack_missing": {"action": "auto_install_gstack", "prompt": "gstack not found. Auto-installing..."},
        "claude_md_missing": {"action": "generate_default_claude_md", "prompt": "CLAUDE.md missing. Generating default..."},
        "freeze_active": {"action": "halt_and_report", "prompt": "Codebase frozen. Use /unfreeze."}
      }
    },

    "task_receive": {
      "order": 2,
      "auto": true,
      "blocking": false,
      "description": "Fires when a new task is received. Classifies task type and routes to workflow.",
      "actions": [
        {"action": "classify_task", "method": "type_decision_tree", "required": true},
        {"action": "create_todo_list", "tool": "TodoWrite", "required": true},
        {"action": "estimate_token_budget", "method": "complexity_heuristic", "required": true},
        {"action": "inject_context", "template": "task_context", "required": true},
        {"action": "load_skill", "method": "lazy_load_by_type", "required": true}
      ],
      "failover": {
        "classification_failed": {"action": "default_to_type1", "prompt": "Unclassifiable task. Defaulting to Type 1 (Document)."},
        "todo_creation_failed": {"action": "proceed_without_todo", "prompt": "TODO list creation failed. Proceeding with inline tracking."}
      }
    },

    "pre_execution": {
      "order": 3,
      "auto": true,
      "blocking": true,
      "description": "Fires before executing any task. Validates prerequisites and locks resources.",
      "actions": [
        {"action": "check_freeze", "file": "/home/z/my-project/.freeze", "required": false, "inverted": true},
        {"action": "check_worklog_conflicts", "method": "scan_worklog_for_active_tasks", "required": false},
        {"action": "verify_output_dir", "path": "/home/z/my-project/download/", "required": true},
        {"action": "inject_context", "template": "execution_context", "required": true}
      ],
      "failover": {
        "freeze_active": {"action": "halt_and_report", "prompt": "Codebase frozen. Cannot execute."},
        "output_dir_missing": {"action": "create_output_dir", "path": "/home/z/my-project/download/"},
        "worklog_conflict": {"action": "warn_and_proceed", "prompt": "Another agent may be working. Proceeding with caution."}
      }
    },

    "skill_invoke": {
      "order": 4,
      "auto": false,
      "blocking": false,
      "description": "Fires when a gstack skill is invoked. Lazy-loads only the needed skill.",
      "actions": [
        {"action": "resolve_skill_path", "base": "~/.claude/skills", "required": true},
        {"action": "inject_skill_preamble", "source": "ETHOS.md + skill-specific context", "required": true},
        {"action": "load_skill", "method": "lazy_load_single", "required": true}
      ],
      "failover": {
        "skill_not_found": {"action": "fallback_to_generic", "prompt": "Skill not found. Falling back to generic implementation."},
        "skill_load_error": {"action": "retry_once_then_generic", "prompt": "Skill load failed. Retrying... then falling back."}
      }
    },

    "subagent_dispatch": {
      "order": 5,
      "auto": false,
      "blocking": false,
      "description": "Fires when dispatching a subagent. Compresses context and injects worklog pointer.",
      "actions": [
        {"action": "compress_context", "method": "bullet_point_specs", "required": true},
        {"action": "inject_worklog_pointer", "file": "/home/z/my-project/worklog.md", "required": true},
        {"action": "assign_task_id", "method": "increment_from_todo", "required": true},
        {"action": "set_output_requirements", "method": "explicit_path_and_format", "required": true}
      ],
      "failover": {
        "context_too_large": {"action": "truncate_to_essentials", "max_tokens": 8000},
        "subagent_timeout": {"action": "retry_with_simpler_prompt", "max_retries": 1}
      }
    },

    "post_execution": {
      "order": 6,
      "auto": true,
      "blocking": false,
      "description": "Fires after task execution. Validates output, updates worklog, cleans up.",
      "actions": [
        {"action": "validate_output", "method": "file_exists_and_nonempty", "required": true},
        {"action": "update_worklog", "file": "/home/z/my-project/worklog.md", "required": true},
        {"action": "mark_todo_complete", "tool": "TodoWrite", "required": true},
        {"action": "cleanup_temp_files", "path": "/home/z/my-project/download/", "required": false},
        {"action": "update_session_state", "file": "/home/z/my-project/.claude/session-state.json", "required": false}
      ],
      "failover": {
        "output_missing": {"action": "log_error_and_report", "prompt": "Output file missing. Task may have failed."},
        "worklog_update_failed": {"action": "retry_once", "max_retries": 1},
        "cleanup_failed": {"action": "log_warning_only", "prompt": "Cleanup failed. Non-critical."}
      }
    },

    "error_recovery": {
      "order": 7,
      "auto": true,
      "blocking": false,
      "description": "Fires on any error. Implements the 2-retry-then-escalate protocol.",
      "actions": [
        {"action": "log_error", "target": "worklog.md", "required": true},
        {"action": "increment_retry_counter", "key": "error_retry_count", "max": 2, "required": true},
        {"action": "retry_with_adjusted_params", "method": "increase_timeout_or_simplify", "required": false},
        {"action": "escalate_to_user", "condition": "retry_count >= 2", "required": true}
      ],
      "failover": {
        "escalation_failed": {"action": "write_error_file", "path": "/home/z/my-project/.claude/error-pending.json"},
        "log_failed": {"action": "write_stderr", "prompt": "Critical: Could not write to worklog."}
      }
    }
  },

  "workflow_router": {
    "description": "AI only triggers into certified workflows. No ad-hoc paths.",
    "routes": {
      "document_creation": {
        "type": "Type 1",
        "trigger_patterns": ["generate document", "create report", "write PRD", "make PDF", "docx", "xlsx", "ppt", "proposal", "manuscript"],
        "certified_skills": ["/office-hours", "/design-consultation", "/document-generate", "/document-release", "/make-pdf"],
        "certified_system_skills": ["pdf", "docx", "xlsx", "ppt"],
        "fallback_skill": "pdf",
        "context_template": "document_context"
      },
      "data_visualization": {
        "type": "Type 2",
        "trigger_patterns": ["chart", "graph", "diagram", "flowchart", "mind map", "visualization", "plot", "architecture diagram"],
        "certified_skills": ["/design-consultation", "/design-shotgun", "/design-review"],
        "certified_system_skills": ["charts"],
        "fallback_skill": "charts",
        "context_template": "visualization_context"
      },
      "web_development": {
        "type": "Type 3",
        "trigger_patterns": ["webpage", "web app", "dashboard", "interactive", "frontend", "Next.js", "website", "UI"],
        "certified_skills": ["/design-consultation", "/design-html", "/design-review", "/qa", "/ship", "/review"],
        "certified_system_skills": ["fullstack-dev"],
        "fallback_skill": "fullstack-dev",
        "context_template": "webdev_context"
      },
      "data_processing": {
        "type": "Type 4",
        "trigger_patterns": ["process data", "analyze", "transform", "calculate", "statistics", "parse", "clean data"],
        "certified_skills": ["/investigate", "/benchmark", "/health"],
        "certified_system_skills": [],
        "fallback_skill": "python_script",
        "context_template": "data_context"
      }
    },
    "default_route": "document_creation",
    "ambiguity_resolution": "Ask user to clarify: Document with charts OR Interactive web page?"
  }
}
